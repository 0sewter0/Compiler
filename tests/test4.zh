int main() {
    int arr[4];
    arr[0] = 10;
    arr[1] = 5;
    arr[2] = 4;
    arr[3] = 1;
    int pass = 0;
    while(pass < 3) {
        int i = 0;
        while(i < 3 - pass) {
            if(arr[i] < arr[i+1]) {
                i = i + 1;
                continue;
            }
            if(arr[i] > arr[i+1]) {
                int swap = arr[i];
                arr[i] = arr[i+1];
                arr[i+1] = swap;
            }
            i = i + 1;
        }
        pass = pass + 1;
    }
    return arr[3];
}